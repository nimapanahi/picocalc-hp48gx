.program lcd_spi
.side_set 1

; PicoCalc ST7365P-compatible SPI master: mode 3 (CPOL=1, CPHA=1).
; A byte is supplied in the most-significant byte of each TX FIFO word.
; Manual unrolling preserves the trailing rising clock edge of every byte.

public entry_point:
.wrap_target
    pull            side 1
    out pins, 1     side 0
    nop             side 1
    out pins, 1     side 0
    nop             side 1
    out pins, 1     side 0
    nop             side 1
    out pins, 1     side 0
    nop             side 1
    out pins, 1     side 0
    nop             side 1
    out pins, 1     side 0
    nop             side 1
    out pins, 1     side 0
    nop             side 1
    out pins, 1     side 0
    nop             side 1
.wrap
